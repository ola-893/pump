# Optional NEAR Intents 1Click API key. Copy to .env and keep the value server-side.
PUMPCOIN_ONECLICK_API_KEY=

# For a shared directory, start npm run directory:serve and export
# PUMP_DIRECTORY_URL=http://127.0.0.1:5198 in the frontend server's shell.

# Netlify build: public HTTPS origin of the Railway backend (no trailing path).
# PUMP_PUBLIC_API_URL=https://your-service.up.railway.app

# Railway: persistent SQLite on an attached /data volume.
# PUMP_PUBLIC_DB=/data/pump.sqlite
# PUMP_DIRECTORY_ORIGIN=https://your-service.up.railway.app/api/pump-directory
# PUMP_DIRECTORY_CLIENT_ORIGINS=https://your-site.netlify.app
